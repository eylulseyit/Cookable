{
    "theme": {
      "name": "Food Dashboard",
      "mode": "light",
      "primaryFont": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "secondaryFont": "Poppins, sans-serif"
    },
    "colors": {
      "primary": {
        "50": "#fff7ed",
        "100": "#ffedd5",
        "200": "#fed7aa",
        "300": "#fdba74",
        "400": "#fb923c",
        "500": "#f97316",
        "600": "#ea580c",
        "700": "#c2410c",
        "800": "#9a3412",
        "900": "#7c2d12"
      },
      "secondary": {
        "50": "#f0fdf4",
        "100": "#dcfce7",
        "200": "#bbf7d0",
        "300": "#86efac",
        "400": "#4ade80",
        "500": "#22c55e",
        "600": "#16a34a",
        "700": "#15803d",
        "800": "#166534",
        "900": "#14532d"
      },
      "accent": {
        "50": "#fef3c7",
        "100": "#fde68a",
        "200": "#fcd34d",
        "300": "#fbbf24",
        "400": "#f59e0b",
        "500": "#d97706",
        "600": "#b45309",
        "700": "#92400e",
        "800": "#78350f",
        "900": "#451a03"
      },
      "neutral": {
        "50": "#f9fafb",
        "100": "#f3f4f6",
        "200": "#e5e7eb",
        "300": "#d1d5db",
        "400": "#9ca3af",
        "500": "#6b7280",
        "600": "#4b5563",
        "700": "#374151",
        "800": "#1f2937",
        "900": "#111827"
      },
      "background": {
        "primary": "#ffffff",
        "secondary": "#f9fafb",
        "tertiary": "#f3f4f6"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#4b5563",
        "muted": "#6b7280",
        "inverse": "#ffffff"
      },
      "status": {
        "success": "#22c55e",
        "warning": "#f59e0b",
        "error": "#ef4444",
        "info": "#3b82f6"
      }
    },
    "typography": {
      "h1": {
        "fontSize": "2.5rem",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "letterSpacing": "-0.025em",
        "color": "text.primary"
      },
      "h2": {
        "fontSize": "2rem",
        "fontWeight": "600",
        "lineHeight": "1.3",
        "letterSpacing": "-0.025em",
        "color": "text.primary"
      },
      "h3": {
        "fontSize": "1.5rem",
        "fontWeight": "600",
        "lineHeight": "1.4",
        "color": "text.primary"
      },
      "h4": {
        "fontSize": "1.25rem",
        "fontWeight": "600",
        "lineHeight": "1.5",
        "color": "text.primary"
      },
      "body": {
        "fontSize": "1rem",
        "fontWeight": "400",
        "lineHeight": "1.6",
        "color": "text.secondary"
      },
      "caption": {
        "fontSize": "0.875rem",
        "fontWeight": "500",
        "lineHeight": "1.5",
        "color": "text.muted"
      },
      "small": {
        "fontSize": "0.75rem",
        "fontWeight": "400",
        "lineHeight": "1.4",
        "color": "text.muted"
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem"
    },
    "borderRadius": {
      "none": "0",
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "2xl": "1.5rem",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
    },
    "components": {
      "card": {
        "background": "background.primary",
        "borderRadius": "lg",
        "padding": "lg",
        "boxShadow": "md",
        "border": "1px solid #e5e7eb"
      },
      "button": {
        "primary": {
          "background": "primary.500",
          "color": "text.inverse",
          "borderRadius": "md",
          "padding": "sm lg",
          "fontWeight": "500",
          "hover": {
            "background": "primary.600"
          }
        },
        "secondary": {
          "background": "neutral.100",
          "color": "text.primary",
          "borderRadius": "md",
          "padding": "sm lg",
          "fontWeight": "500",
          "hover": {
            "background": "neutral.200"
          }
        },
        "outline": {
          "background": "transparent",
          "color": "primary.500",
          "border": "1px solid",
          "borderColor": "primary.500",
          "borderRadius": "md",
          "padding": "sm lg",
          "fontWeight": "500",
          "hover": {
            "background": "primary.50"
          }
        }
      },
      "input": {
        "background": "background.primary",
        "border": "1px solid #d1d5db",
        "borderRadius": "md",
        "padding": "sm md",
        "fontSize": "body.fontSize",
        "focus": {
          "borderColor": "primary.500",
          "outline": "2px solid rgba(249, 115, 22, 0.2)"
        }
      },
      "navbar": {
        "background": "background.primary",
        "borderBottom": "1px solid #e5e7eb",
        "padding": "sm lg",
        "height": "4rem"
      },
      "sidebar": {
        "background": "background.secondary",
        "width": "16rem",
        "padding": "lg md"
      },
      "badge": {
        "success": {
          "background": "secondary.100",
          "color": "secondary.700",
          "borderRadius": "full",
          "padding": "xs sm",
          "fontSize": "small.fontSize",
          "fontWeight": "500"
        },
        "warning": {
          "background": "accent.100",
          "color": "accent.700",
          "borderRadius": "full",
          "padding": "xs sm",
          "fontSize": "small.fontSize",
          "fontWeight": "500"
        },
        "error": {
          "background": "#fef2f2",
          "color": "#991b1b",
          "borderRadius": "full",
          "padding": "xs sm",
          "fontSize": "small.fontSize",
          "fontWeight": "500"
        }
      },
      "progressBar": {
        "background": "neutral.200",
        "fill": "primary.500",
        "height": "0.5rem",
        "borderRadius": "full"
      },
      "tooltip": {
        "background": "neutral.800",
        "color": "text.inverse",
        "borderRadius": "md",
        "padding": "xs sm",
        "fontSize": "small.fontSize",
        "boxShadow": "lg"
      },
      "modal": {
        "background": "background.primary",
        "borderRadius": "xl",
        "padding": "xl",
        "boxShadow": "xl",
        "overlay": "rgba(0, 0, 0, 0.5)"
      }
    },
    "icons": {
      "size": {
        "xs": "1rem",
        "sm": "1.25rem",
        "md": "1.5rem",
        "lg": "2rem",
        "xl": "2.5rem"
      },
      "library": "lucide-react",
      "common": {
        "home": "Home",
        "user": "User",
        "settings": "Settings",
        "search": "Search",
        "menu": "Menu",
        "close": "X",
        "check": "Check",
        "heart": "Heart",
        "star": "Star",
        "calendar": "Calendar",
        "clock": "Clock",
        "trending": "TrendingUp",
        "activity": "Activity",
        "utensils": "Utensils",
        "chef": "ChefHat",
        "apple": "Apple",
        "coffee": "Coffee",
        "pizza": "Pizza",
        "bookmark": "Bookmark",
        "share": "Share2",
        "filter": "Filter",
        "sort": "ArrowUpDown"
      }
    },
    "layout": {
      "container": {
        "maxWidth": "1200px",
        "margin": "0 auto",
        "padding": "0 lg"
      },
      "grid": {
        "columns": {
          "mobile": 1,
          "tablet": 2,
          "desktop": 3,
          "wide": 4
        },
        "gap": "lg"
      }
    },
    "breakpoints": {
      "mobile": "480px",
      "tablet": "768px",
      "desktop": "1024px",
      "wide": "1280px"
    },
    "animations": {
      "transition": {
        "fast": "150ms ease-in-out",
        "normal": "300ms ease-in-out",
        "slow": "500ms ease-in-out"
      },
      "hover": {
        "scale": "1.02",
        "transition": "transform 150ms ease-in-out"
      },
      "fadeIn": {
        "keyframes": "fadeIn 300ms ease-in-out",
        "from": { "opacity": 0, "transform": "translateY(10px)" },
        "to": { "opacity": 1, "transform": "translateY(0)" }
      }
    },
    "foodTheme": {
      "categories": {
        "healthy": {
          "color": "secondary.500",
          "icon": "Apple",
          "background": "secondary.50"
        },
        "comfort": {
          "color": "accent.500",
          "icon": "Coffee",
          "background": "accent.50"
        },
        "gourmet": {
          "color": "primary.500",
          "icon": "ChefHat",
          "background": "primary.50"
        },
        "quick": {
          "color": "status.info",
          "icon": "Clock",
          "background": "#eff6ff"
        }
      },
      "nutritionColors": {
        "calories": "#f97316",
        "protein": "#22c55e",
        "carbs": "#3b82f6",
        "fat": "#f59e0b",
        "fiber": "#8b5cf6",
        "sugar": "#ef4444"
      },
      "difficultyLevels": {
        "easy": {
          "color": "secondary.500",
          "background": "secondary.100"
        },
        "medium": {
          "color": "accent.500",
          "background": "accent.100"
        },
        "hard": {
          "color": "primary.500",
          "background": "primary.100"
        }
      }
    }
  }